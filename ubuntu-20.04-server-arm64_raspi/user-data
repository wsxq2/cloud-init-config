## Run arbitrary commands at rc.local like time
runcmd:
- |
  # Set proxy for all commands
  export https_proxy=http://192.168.3.121:7890
  
  # Download ROS GPG key
  curl -sSL 'https://raw.githubusercontent.com/ros/rosdistro/master/ros.key' -o /usr/share/keyrings/ros-archive-keyring.gpg
  
  # Add ROS repository
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] http://packages.ros.org/ros/ubuntu $(lsb_release -sc) main" > /etc/apt/sources.list.d/ros-latest.list
  
  # Update package list
  apt-get update
  
  # Initialize rosdep (with proxy)
  rosdep init || true
  
  # Update rosdep as pi user (with proxy)
  sudo -u pi sh -c 'export https_proxy=http://192.168.3.121:7890 && rosdep update'

swap:
  filename: /swapfile
  size: auto
  maxsize: 16G